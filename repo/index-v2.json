{"repo": {"name": {"en-US": "Sovereign Edge"}, "description": {"en-US": "Pocket Agent, a private on-device Claude agent for GrapheneOS, published by Sovereign Edge Inc."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "d49d9000343112aa4f2ec8e9309fcf423dbc78298de8c2a2924a52f18d1107c2", "size": 806}}, "address": "https://frenchtoastbig7-ux.github.io/fdroid/repo", "timestamp": 1789347770000, "antiFeatures": {"NonFreeNet": {"description": {"en-US": "This app promotes or depends entirely on a non-free network service"}, "name": {"en-US": "Non-Free Network Services"}}}, "categories": {"AI Chat": {"name": {"en-US": "AI Chat"}, "description": {"en-US": "AI assistants, chatbots, and large language model (LLM) interfaces"}}}}, "packages": {"com.sovereignedge.pocketagent": {"metadata": {"added": 1789344199000, "categories": ["AI Chat"], "issueTracker": "https://github.com/frenchtoastbig7-ux/pocket-agent/issues", "lastUpdated": 1789347770000, "license": "Apache-2.0", "sourceCode": "https://github.com/frenchtoastbig7-ux/pocket-agent", "authorName": "Sovereign Edge Inc.", "name": {"en-US": "Pocket Agent"}, "summary": {"en-US": "Private on-device Claude agent with memory, skills and automations"}, "description": {"en-US": "Pocket Agent is a personal assistant that runs on your phone and uses Claude as its model. It is built for GrapheneOS and talks to exactly one server: Anthropic's API.\n\nWhat it can do, with your permission:\n* Read and send SMS, look up contacts, read and add calendar events, read the call log and recent notifications\n* Read and write files in a private workspace folder\n* Search and read the web\n* Read the screen and tap, type and scroll in other apps (accessibility service)\n* Remember you across chats (MEMORY.md / USER.md), write reusable skills, and search past chats\n* Run scheduled automations that report back in a private notification\n* Split research into parallel read-only sub-agents\n\nAnything that sends, taps, types or changes data is shown to you for approval first. Scheduled runs are read-only. The API key is encrypted with the Android Keystore. There are no analytics and no Google Play Services.\n\nYou need your own Anthropic API key."}, "preferredSigner": "75b96d096a86ea8c58641a92531fcb5b4a6d2efc00b33051620969baad85450d"}, "versions": {"56d48eca9d31d62dc61100fe936f4d211076d23058fb25293e49bc13e8045a01": {"added": 1789347770000, "file": {"name": "/com.sovereignedge.pocketagent_2.apk", "sha256": "56d48eca9d31d62dc61100fe936f4d211076d23058fb25293e49bc13e8045a01", "size": 26256467}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.2.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 33, "targetSdkVersion": 36}, "signer": {"sha256": ["75b96d096a86ea8c58641a92531fcb5b4a6d2efc00b33051620969baad85450d"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.READ_SMS"}, {"name": "android.permission.SEND_SMS"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "com.sovereignedge.pocketagent.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}, "antiFeatures": {"NonFreeNet": {"en-US": "Requires an Anthropic API key. Your prompts and the tool results the agent reads are processed by Anthropic's Claude API."}}}, "5c5f2f3f873c089d1f7a1cb68603f4d5790eeb50e8b9b81cf4954493ae1c07da": {"added": 1789344199000, "file": {"name": "/com.sovereignedge.pocketagent_1.apk", "sha256": "5c5f2f3f873c089d1f7a1cb68603f4d5790eeb50e8b9b81cf4954493ae1c07